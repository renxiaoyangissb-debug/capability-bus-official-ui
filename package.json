{
  "name": "@capability-bus/official-ui",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Official Capability Bus interface-plugin shell",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bootstrap:offline": "node scripts/bootstrap-offline-cache.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test/**/*.test.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "integrity:check": "node scripts/check-integrity-policy.mjs",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs && node scripts/check-plugin-package.mjs",
    "verify": "npm run contracts:check && npm run typecheck && npm test && npm run build && npm run licenses:check && npm run integrity:check"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.2.0"
  }
}
