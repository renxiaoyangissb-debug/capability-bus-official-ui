{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capability-bus.local/contracts/v0.1/request-envelope.schema.json",
  "title": "RequestEnvelope v0.1 candidate",
  "type": "object",
  "required": ["request_id", "trace_id", "capability", "caller", "payload", "created_at", "protocol_version"],
  "additionalProperties": false,
  "properties": {
    "request_id": {"type": "string", "pattern": "^req_[0-9a-f]{32}$"},
    "trace_id": {"type": "string", "pattern": "^trace_[0-9a-f]{32}$"},
    "capability": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)+$"},
    "caller": {
      "type": "object",
      "required": ["subject_id"],
      "additionalProperties": false,
      "properties": {"subject_id": {"type": "string", "minLength": 1, "maxLength": 256}}
    },
    "grant": {
      "type": ["object", "null"],
      "required": ["grant_id"],
      "additionalProperties": false,
      "properties": {"grant_id": {"type": "string", "minLength": 1, "maxLength": 256}}
    },
    "idempotency_key": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "payload": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "protocol_version": {"const": "0.1.0-alpha.1"}
  }
}
