{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capability-bus.local/contracts/v0.1/grant.schema.json",
  "title": "Grant v0.1 candidate",
  "type": "object",
  "required": ["grant_id", "subject_id", "plugin_system_id", "capability", "scope", "status", "expires_at", "created_at"],
  "additionalProperties": false,
  "properties": {
    "grant_id": {"type": "string", "pattern": "^grant_[0-9a-f]{32}$"},
    "subject_id": {"type": "string", "minLength": 1},
    "plugin_system_id": {"type": "string", "pattern": "^plugin_[0-9a-f]{32}$"},
    "capability": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)+$"},
    "scope": {
      "type": "object",
      "required": ["capabilities"],
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)+$"}
        }
      }
    },
    "status": {"enum": ["active", "revoked"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
