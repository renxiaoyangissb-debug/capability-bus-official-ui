{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Bus Official UI U4 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["bind_host", "port", "session_ttl_minutes", "theme", "language", "audit_page_size"],
  "properties": {
    "bind_host": { "const": "127.0.0.1" },
    "port": { "const": 0 },
    "session_ttl_minutes": { "const": 30 },
    "theme": { "enum": ["system", "light", "dark"] },
    "language": { "enum": ["zh-CN", "en"] },
    "audit_page_size": { "const": 50 }
  }
}
